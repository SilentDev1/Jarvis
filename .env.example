JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_ADMIN_TOKEN=change-this-to-a-long-random-value
JARVIS_ADMIN_USERNAME=admin
JARVIS_ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_DAYS=30
DEVICE_GATEWAY_HOST=127.0.0.1
DEVICE_GATEWAY_PORT=8766
JARVIS_CORE_URL=http://127.0.0.1:8765
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional absolute path to an uncommitted named-tunnel config. Its ingress must
# point only to http://127.0.0.1:8766 and end with a 404 catch-all.
CLOUDFLARE_TUNNEL_CONFIG=
DATA_DIR=./data
LOG_DIR=./logs
CAMERA_MODE=test
CAMERA_NAME="Tapo C101"
CAMERA_HOST=
CAMERA_USERNAME=
CAMERA_PASSWORD=
CAMERA_RTSP_URL_MAIN=
CAMERA_RTSP_URL_SUB=
VISION_PROVIDER=mock
VISION_MODEL=yolo11n.pt
DETECTION_CONFIDENCE=0.5
DETECTION_FPS=3
# Use simulator only for local UI/tests. aipi_stock fails closed because stock
# firmware 1.2.5 has no supported server-initiated speech/listen API.
VOICE_SATELLITE=aipi_stock
VISITOR_LISTEN_TIMEOUT_SECONDS=15
VISITOR_CONVERSATION_MAX_SECONDS=120
VISITOR_CONVERSATION_MAX_TURNS=8
PERSONALIZE_KNOWN_VISITOR_GREETING=false
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
DWELL_SECONDS=2.5
DISAPPEAR_GRACE_SECONDS=4
GREETING_COOLDOWN_SECONDS=60
SESSION_TIMEOUT_SECONDS=300
ZONE_OBSERVATION="0.02,0.05;0.98,0.05;0.98,0.98;0.02,0.98"
ZONE_APPROACH="0.15,0.25;0.85,0.25;0.90,0.98;0.10,0.98"
ZONE_INTERACTION="0.28,0.48;0.72,0.48;0.82,0.98;0.18,0.98"
STORE_TRANSCRIPTS=true
STORE_VISITOR_IMAGES=true
STORE_BADGE_IMAGES=true
RECORD_AUDIO=false
FACE_RECOGNITION=true
FACE_DETECTION_MODEL=./data/models/face_detection_yunet_2026may.onnx
FACE_RECOGNITION_MODEL=./data/models/face_recognition_sface_2021dec.onnx
FACE_RECOGNITION_THRESHOLD=0.45
FACE_POSSIBLE_THRESHOLD=0.36
MEDIA_RETENTION_DAYS=30
NOTIFICATION_PROVIDER=log
HA_MQTT_ENABLED=false
