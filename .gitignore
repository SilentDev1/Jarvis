.env
# Any .env variant carries live credentials. Backups and per-host overrides are
# easy to create by accident, so ignore them all and re-allow only the example.
.env.*
!.env.example
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
data/*.db*
data/*token*
data/zones.json
data/media/*
!data/media/.gitkeep
data/models/
# Firmware store: built binaries are build artifacts, not source. The signed
# manifests are reproducible from a build plus the signing key.
data/firmware/
data/arc_light.json
data/faces/
*.pt
logs/*
!logs/.gitkeep
run/
backups/
firmware/**/build/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/
data/audio/
*.pcm
*.wav
.DS_Store

# Out-of-tree verification build (JARVIS-001); the in-tree build/ is ignored above.
firmware/aipi-jarvis/build-verify/
